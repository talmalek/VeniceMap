# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GOOGLE_MAPS_API_KEY / VITE_GOOGLE_MAPS_API_KEY: Required for Google Maps Platform JavaScript SDK.
GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"
VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# UNLOCK_PASSWORD: Optional password used to AES-256-GCM encrypt the Maps API key at build time.
UNLOCK_PASSWORD="MY_UNLOCK_PASSWORD"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
